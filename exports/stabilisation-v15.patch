diff --git a/dist/advanced/catalog-link.mjs b/dist/advanced/catalog-link.mjs
new file mode 100644
index 0000000..0a651db
--- /dev/null
+++ b/dist/advanced/catalog-link.mjs
@@ -0,0 +1,17 @@
+import {replaceEquipment} from './equipment-picker.mjs';
+// A shared build is authoritative: stale catalogue parameters must not alter it.
+export function applyCatalogLink(build,catalog,search,hash=''){
+ if(new URLSearchParams(hash.slice(1)).has('build'))return {build};
+ const params=new URLSearchParams(search),ref=params.get('equipment');let part,message;
+ if(ref){const [kind,id,...extra]=ref.split(':');
+  if(!extra.length&&id&&['armor','weapon','charm'].includes(kind)){
+   if(kind==='charm'){const charm=catalog.charms.find(c=>c.id==='charm-'+id);if(charm){build={...build,talisman:charm};message=charm.name+' sélectionné.'}}
+   else {const item=catalog.equipment.find(e=>e.id===kind+'-'+id);if(item){part=item.part;build=replaceEquipment(build,catalog,part,item.id);message=item.name+' équipé depuis le catalogue.'}}
+  }
+  message ||= 'Équipement introuvable dans cette version du catalogue. Montage conservé.';
+ }
+ const jewel=params.get('jewel'),gem=catalog.decorations.find(g=>g.id==='gem-'+jewel);
+ if(gem)message=gem.name+' retrouvé. Choisissez un emplacement compatible pour l’équiper.';
+ else if(jewel)message='Joyau introuvable dans cette version du catalogue.';
+ return {build,part,gem,message};
+}
